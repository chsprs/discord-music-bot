# Isi melalui prompt rahasia/vault, jangan kirim token di chat.
DISCORD_TOKEN=
# Opsional: server uji untuk pendaftaran slash command cepat.
DISCORD_GUILD_ID=
# Opsional: volume suara bawaan bot (0.0 sampai 2.0, default 0.5 = 50%).
# DEFAULT_VOLUME=0.5
# Opsional: lokasi cookies.txt untuk video age-restricted / butuh login.
# Kosongkan untuk memakai ./cookies.txt bila ada. Berkas ini berisi sesi
# login YouTube — perlakukan seperti password, jangan commit.
# YTDLP_COOKIES=/opt/discord-music-bot/cookies.txt
# Jumlah lagu yang diambil dari YouTube Mix tiap rekomendasi (1-50, default 15).
# Makin besar makin banyak pilihan tapi ekstraksi makin lambat.
#MIX_RESULT_LIMIT=15
